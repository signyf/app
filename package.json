{
  "name": "tianqi-widget",
  "version": "1.10.0",
  "private": true,
  "description": "无边框 Windows 桌面天气小挂件",
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer.js --bundle --outfile=dist/renderer.js --format=iife --platform=browser --charset=utf8",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "test": "node --test",
    "dist": "npm run build:renderer && electron-builder --win portable"
  },
  "dependencies": {
    "lunar-javascript": "1.7.7"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.10"
  },
  "build": {
    "appId": "local.tianqi.widget",
    "productName": "天气小挂件",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/preload.js"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "tianqi-widget-${version}-portable.${ext}",
      "signAndEditExecutable": false
    },
    "asar": true
  }
}
